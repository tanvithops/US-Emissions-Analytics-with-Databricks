{
  "datasets": [
    {
      "name": "b17d29b9",
      "displayName": "Gold - County Metrics",
      "queryLines": [
        "SELECT\r\n",
        "    county_id,\r\n",
        "    county_name,\r\n",
        "    county_state_name,\r\n",
        "    state_id,\r\n",
        "    state_abbr,\r\n",
        "    latitude,\r\n",
        "    longitude,\r\n",
        "    population,\r\n",
        "    ghg_emissions_mtons_co2e,\r\n",
        "    emissions_per_person\r\n",
        "FROM emissions.gold.county_metrics;"
      ]
    },
    {
      "name": "6fbb0dfa",
      "displayName": "Gold - State Emissions",
      "queryLines": [
        "SELECT\r\n",
        "    state_abbr,\r\n",
        "    total_population,\r\n",
        "    total_emissions,\r\n",
        "    emissions_per_person,\r\n",
        "    percentage_of_us_emissions,\r\n",
        "    emissions_rank\r\n",
        "FROM emissions.gold.state_emissions;"
      ]
    },
    {
      "name": "a868a8cb",
      "displayName": "Gold - Top 10 States",
      "queryLines": [
        "SELECT\r\n",
        "    state_abbr,\r\n",
        "    total_emissions,\r\n",
        "    percentage_of_us_emissions,\r\n",
        "    emissions_rank\r\n",
        "FROM emissions.gold.state_emissions\r\n",
        "WHERE emissions_rank <= 10\r\n",
        "ORDER BY emissions_rank;"
      ]
    },
    {
      "name": "3183d345",
      "displayName": "Gold - Top 10 Counties",
      "queryLines": [
        "SELECT\r\n",
        "    county_state_name,\r\n",
        "    state_abbr,\r\n",
        "    population,\r\n",
        "    ghg_emissions_mtons_co2e AS total_emissions\r\n",
        "FROM emissions.gold.county_metrics\r\n",
        "ORDER BY ghg_emissions_mtons_co2e DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "3ff13b13",
      "displayName": "Gold - Emissions Summary",
      "queryLines": [
        "SELECT\r\n",
        "    total_us_emissions,\r\n",
        "    top10_emissions,\r\n",
        "    top10_percentage\r\n",
        "FROM emissions.gold.emissions_summary;"
      ]
    }
  ],
