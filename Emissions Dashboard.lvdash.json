{
  "datasets": [
    {
      "name": "d6ee9b3d",
      "displayName": "Location Data",
      "config": {
        "version": "1.1",
        "source": "select \r\nlatitude,\r\nlongitude,\r\n`GHG emissions mtons CO2e`\r\nfrom emissions.default.emissions_data",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "56c130b1",
      "displayName": "Emission per person",
      "queryLines": [
        "SELECT\r\n",
        "    county_state_name,\r\n",
        "    population,\r\n",
        "    CAST(\r\n",
        "        REPLACE(`GHG emissions mtons CO2e`, ',', '')\r\n",
        "        AS DOUBLE\r\n",
        "    ) /\r\n",
        "    NULLIF(\r\n",
        "        CAST(\r\n",
        "            REPLACE(population, ',', '')\r\n",
        "            AS DOUBLE\r\n",
        "        ),\r\n",
        "        0\r\n",
        "    ) AS emissions_per_person\r\n",
        "FROM emissions_data\r\n",
        "ORDER BY emissions_per_person DESC"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "056328ad",
      "displayName": "Total emission per state",
      "queryLines": [
        "\r\n",
        "SELECT state_abbr,\r\n",
        "       SUM(CAST(\r\n",
        "           REPLACE(`GHG emissions mtons CO2e`, ',', '')\r\n",
        "           AS DOUBLE\r\n",
        "       )) AS Total_Emissions\r\n",
        "FROM emissions_data\r\n",
        "GROUP BY state_abbr\r\n",
        "ORDER BY Total_Emissions DESC\r\n",
        "LIMIT 10"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "c50b39d2",
      "displayName": "County Shaming",
      "queryLines": [
        "SELECT\r\n",
        "    county_state_name,\r\n",
        "    population,\r\n",
        "    CAST(\r\n",
        "        REPLACE(`GHG emissions mtons CO2e`, ',', '')\r\n",
        "        AS DOUBLE\r\n",
        "    ) AS Total_Emissions\r\n",
        "FROM emissions_data\r\n",
        "ORDER BY Total_Emissions DESC\r\n",
        "LIMIT 10;"
      ],
      "catalog": "emissions",
      "schema": "default"
    }
  ],
